# O ambiente da prova local de PRA-115 — Postgres e MinIO em contêiner.
#
# ⚠️ ISTO NÃO É O `.env`, E NÃO O SUBSTITUI. O `.env` é o desenvolvimento de
# quem trabalha aqui: `belmare_dev` na porta 5432 e uploads em `.uploads/`. Este
# arquivo é lido POR CIMA dele, só na sessão que roda a prova, com o comando do
# README:
#
#     set -a && . ./prova-local.env && set +a && pnpm dev
#
# Variável já posta no processo ganha da que está no `.env` — é o Next que
# decide assim —, então nada aqui reescreve nada lá. Fechar o terminal desfaz.
#
# ⚠️ Este arquivo É versionado, ao contrário do `.env`, e é seguro: não há
# segredo nenhum nele. As credenciais abaixo abrem um MinIO que só existe
# enquanto o `docker compose` estiver de pé, na sua máquina, na sua rede local.
# Um segredo de verdade aqui seria um segredo publicado.

# ── Banco ─────────────────────────────────────────────────────────────────────
# O Postgres do contêiner, na porta 55432 e com nome próprio. Deslocado do 5432
# de propósito: `belmare_dev` e `belmare_teste` moram no Postgres da máquina e
# não podem ser tocados por uma pilha que se apaga com `docker compose down -v`.
DATABASE_URI=postgres://belmare:belmare@localhost:55432/belmare_prova

PAYLOAD_SECRET=segredo-da-prova-local-sem-valor-nenhum
PREVIEW_SECRET=preview-da-prova-local-sem-valor-nenhum

# ── O lugar do R2, ocupado pelo MinIO ─────────────────────────────────────────
# São as mesmas cinco variáveis da produção, e é essa a graça: preenchidas, o
# plugin liga e o painel passa a assinar URL e a mandar o navegador fazer o PUT
# direto no bucket. É o MESMO caminho de código; muda o endereço do outro lado.
R2_BUCKET=belmare
R2_ACCESS_KEY_ID=belmare
R2_SECRET_ACCESS_KEY=belmare-segredo-local

# Não há conta Cloudflare aqui — o id fica preenchido porque as cinco variáveis
# precisam estar preenchidas para o plugin ligar, e o endereço real vem da
# `R2_ENDPOINT` logo abaixo.
R2_ACCOUNT_ID=minio-local

# ⚠️ Esta variável NÃO EXISTE EM PRODUÇÃO. Em produção o endereço da API S3 é
# derivado do id da conta; aqui ele aponta para o contêiner. Ver a nota em
# `src/payload.config.ts`.
R2_ENDPOINT=http://localhost:9000

# O domínio de leitura pública. No R2 é o `r2.dev` ou um domínio próprio; no
# MinIO é o mesmo endereço com o bucket no caminho, aberto para leitura anônima
# pelo serviço `bucket` do `docker-compose.yml`.
R2_PUBLIC_URL=http://localhost:9000/belmare
