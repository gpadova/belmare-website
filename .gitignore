# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...menos o exemplo. Ele não tem segredo nenhum e é a única lista de quais
# variáveis o site precisa para subir — fora do repositório, ela vira memória
# de uma pessoa só.
!.env.example

# uploads locais do painel, quando não há R2 configurado
/.uploads/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright-mcp scratch
.playwright-mcp/
